[configuration]
entry_symbol = "simplot_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libgodot_simplot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgodot_simplot.linux.template_debug.x86_64.so"
linux.x86_64 = "res://bin/libgodot_simplot.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://bin/libgodot_simplot.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgodot_simplot.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libgodot_simplot.macos.template_debug.framework"
macos.release = "res://bin/libgodot_simplot.macos.template_release.framework"

